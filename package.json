{
  "name": "examination-hub",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:pages": "playwright test",
    "validate:source": "node scripts/validation/public-boundary.mjs source",
    "validate:dist": "node scripts/validation/public-boundary.mjs dist",
    "verify:private-reference": "node scripts/check-private-reference.mjs",
    "build:bank": "node scripts/question-bank/cli.mjs build",
    "verify:source-answers": "node scripts/question-bank/cli.mjs verify",
    "test:bank": "node --test tests/bank.test.mjs tests/review-bank.test.mjs tests/local-score-projection.test.mjs scripts/question-bank/release-bank.test.mjs",
    "review:bank": "node scripts/question-bank/review.mjs"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
